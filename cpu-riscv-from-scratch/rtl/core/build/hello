#! /usr/local/bin/vvp
:ivl_version "12.0 (stable)" "(v12_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/local/lib/ivl/system.vpi";
:vpi_module "/usr/local/lib/ivl/vhdl_sys.vpi";
:vpi_module "/usr/local/lib/ivl/vhdl_textio.vpi";
:vpi_module "/usr/local/lib/ivl/v2005_math.vpi";
:vpi_module "/usr/local/lib/ivl/va_math.vpi";
:vpi_module "/usr/local/lib/ivl/v2009.vpi";
S_0x614bbb9ea500 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x614bbb9ea690 .scope module, "hello_tb" "hello_tb" 3 3;
 .timescale -9 -12;
v0x614bbb9ea820_0 .var "clk", 0 0;
v0x614bbba35530_0 .var "counter", 3 0;
E_0x614bbb9eaee0 .event posedge, v0x614bbb9ea820_0;
    .scope S_0x614bbb9ea690;
T_0 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x614bbb9ea820_0, 0, 1;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x614bbba35530_0, 0, 4;
    %end;
    .thread T_0, $init;
    .scope S_0x614bbb9ea690;
T_1 ;
    %delay 4000, 0;
    %load/vec4 v0x614bbb9ea820_0;
    %inv;
    %assign/vec4 v0x614bbb9ea820_0, 0;
    %jmp T_1;
    .thread T_1;
    .scope S_0x614bbb9ea690;
T_2 ;
    %wait E_0x614bbb9eaee0;
    %load/vec4 v0x614bbba35530_0;
    %addi 1, 0, 4;
    %assign/vec4 v0x614bbba35530_0, 0;
    %jmp T_2;
    .thread T_2;
    .scope S_0x614bbb9ea690;
T_3 ;
    %vpi_call/w 3 14 "$monitor", "t=%0t counter=%0d", $time, v0x614bbba35530_0 {0 0 0};
    %vpi_call/w 3 15 "$display", "Hello! at the time instant %t", $time {0 0 0};
    %vpi_call/w 3 16 "$dumpfile", "hello.vcd" {0 0 0};
    %vpi_call/w 3 17 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x614bbb9ea690 {0 0 0};
    %delay 100000, 0;
    %vpi_call/w 3 19 "$display", "Now at the time instant %0t the counter value is %0d", $time, v0x614bbba35530_0 {0 0 0};
    %vpi_call/w 3 20 "$finish" {0 0 0};
    %end;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "hello_tb.sv";
